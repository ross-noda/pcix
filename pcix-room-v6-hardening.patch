+            else "'$LIST_ID','Legacy list',123,17"
+        db.execSQL("INSERT INTO lists($listColumns) VALUES($listValues)")
+        db.execSQL(
+            "INSERT INTO tags(id,name,normalizedName,color) VALUES('$TAG_ID','Legacy Tag','legacy tag',456)"
