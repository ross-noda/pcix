{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "P\u00a9ix local window: notifications, browser links and OAuth callback",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "deep-link:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
