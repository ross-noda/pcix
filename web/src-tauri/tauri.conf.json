{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P©ix",
  "version": "0.1.1",
  "identifier": "app.pcix.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "P©ix",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://www.googleapis.com https://openidconnect.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["pcix", "com.example.pix"] } }
  }
}
