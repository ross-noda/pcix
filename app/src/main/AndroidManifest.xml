<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".PixApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/brand_icon_light"
        android:label="@string/app_name"
        android:roundIcon="@drawable/brand_icon_light"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pix">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.sharing" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/sharing_paths" />
        </provider>
        <activity android:name=".widget.SingleTaskWidgetConfigureActivity" android:exported="true" android:theme="@style/Theme.Pix">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".widget.SingleTaskWidgetReceiver" android:exported="true" android:label="@string/single_task_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/single_task_widget_info" />
        </receiver>
        <receiver android:name=".widget.HabitWidgetTapReceiver" android:exported="false" />
        <receiver android:name=".widget.HabitWidgetReceiver" android:exported="true" android:label="@string/h_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/habit_widget_info" />
        </receiver>
        <receiver android:name=".widget.MonthWidgetInteractionReceiver" android:exported="false" />
        <receiver android:name=".widget.CalendarMonthWidgetReceiver" android:exported="true" android:label="@string/month_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_widget_info" />
        </receiver>
        <receiver android:name=".widget.MatrixWidgetReceiver" android:exported="true" android:label="@string/matrix_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/matrix_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.TaskWidgetReceiver"
            android:exported="true"
            android:label="@string/task_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.CalendarWeekWidgetReceiver"
            android:exported="true"
            android:label="@string/calendar_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_week_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.CalendarWidgetInteractionReceiver"
            android:exported="false" />
        <receiver
            android:name=".widget.TaskWidgetDateChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity android:name=".widget.WidgetBackgroundConfigureActivity" android:exported="true" android:theme="@style/Theme.Pix" />
        <activity android:name=".widget.MonthWidgetConfigureActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity
            android:name=".widget.TaskWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Pix" />
        <activity
            android:name=".widget.CalendarWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.Pix" />
        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderRescheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.Pix"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.example.pix" android:host="auth" android:path="/recovery" />
                <data android:scheme="com.example.pix" android:host="auth" android:path="/callback" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".LauncherLight" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:icon="@drawable/brand_icon_light" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherDark" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/brand_icon_dark" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver android:name=".reminders.HabitReminderReceiver" android:exported="false" />
    </application>

</manifest>